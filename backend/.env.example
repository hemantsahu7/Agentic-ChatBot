# --- Secrets (kept on the server, never sent to the frontend) ---
GEMINI_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- API settings ---
# Origin(s) of the React app allowed by CORS (comma-separated for several)
FRONTEND_URL=http://localhost:5173
# Maximum accepted PDF size for POST /api/upload
MAX_UPLOAD_MB=20

# --- Optional ---
# Override the default Gemini model used by the agent
# GEMINI_MODEL=gemini-3.6-flash
